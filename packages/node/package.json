{
  "name": "@errorlenshq/node",
  "version": "1.0.0",
  "description": "ErrorLens for Node.js: errors, tracing, logs and cron monitors. No dependencies.",
  "license": "MIT",
  "homepage": "https://errorlens.io/docs/",
  "repository": { "type": "git", "url": "git+https://github.com/errorlenshq/errorlens-javascript.git", "directory": "packages/node" },
  "bugs": { "url": "https://github.com/errorlenshq/errorlens-javascript/issues" },
  "keywords": ["errorlens", "error tracking", "monitoring", "tracing", "node", "express", "fastify", "koa", "hapi"],
  "type": "module",
