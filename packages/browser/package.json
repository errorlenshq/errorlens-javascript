{
  "name": "@errorlenshq/browser",
  "version": "1.0.1",
  "description": "ErrorLens for browsers: errors, breadcrumbs, page-load tracing and logs. No dependencies.",
  "license": "MIT",
  "homepage": "https://errorlens.io/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/errorlenshq/errorlens-javascript.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/errorlenshq/errorlens-javascript/issues"
  },
  "keywords": [
    "errorlens",
    "error tracking",
    "monitoring",
    "tracing",
    "browser",
    "react",
    "vue",
    "angular",
    "svelte"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@errorlenshq/core": "1.0.1"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs && node ../../scripts/bundle.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "unpkg": "./dist/errorlens.min.js",
  "jsdelivr": "./dist/errorlens.min.js"
}
